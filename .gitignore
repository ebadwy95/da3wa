# Campaign sheets built for a broadcast. Every row carries a guest's phone
# number and their signed invitation link — the link that opens their
# invitation and prints their entry pass. One of these in a repository hands
# the whole guest list, and the door, to anyone who can read it.
data/campaign-*.csv

# local media used only for previewing the invitation opener
public/test/

# rendered social media — regenerate with tools/social/render-posts.mjs
social-out/

# rendered brand assets — regenerate with tools/brand/render-brand.mjs
brand-out/

# Local-only WhatsApp Cloud API test credentials — never commit
.env.cloud-test.local
