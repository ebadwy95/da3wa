# Admin dashboard password (simple single-tenant auth for now)
ADMIN_PASSWORD=changeme

# Secret used to sign invite tokens and QR check-in codes.
# WARNING: changing this invalidates every invite link and every QR code that
# has already been sent to guests. Set it once and keep it.
APP_SECRET=change-this-to-a-long-random-string

# Base URL used to build personal invite links (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://www.da3wa.digital

# Upstash Redis (optional). If not set, the app falls back to a local
# JSON file at data/db.json — fine for local dev, but NOT persistent
# on Vercel/serverless between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wati WhatsApp Business API (required for real WhatsApp sending)
WATI_API_ENDPOINT=https://live-mt-server.wati.io/XXXXXXXX
WATI_ACCESS_TOKEN=

# Names of the Meta-approved templates used for the two automatic sends.
# Both are REQUIRED once WATI_ACCESS_TOKEN is set: the app refuses to send
# (rather than substituting a default template) if the matching name is
# missing, so a misconfiguration can never reach real guests as a placeholder
# message.
#   WATI_INVITE_TEMPLATE_NAME — first contact: "you're invited", carries the
#     guest's personal link. Variables in order: name, couple, link.
#   WATI_QR_TEMPLATE_NAME — sent after a guest confirms, carries their entry
#     QR code. Variables in order: name, couple.
WATI_INVITE_TEMPLATE_NAME=
WATI_QR_TEMPLATE_NAME=

# Only needed on Wati accounts with more than one connected WhatsApp number.
# Leave empty for single-number accounts.
WATI_CHANNEL_NUMBER=
