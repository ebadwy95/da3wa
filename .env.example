# Admin dashboard password (simple single-tenant auth for now)
ADMIN_PASSWORD=changeme

# Secret used to sign invite tokens and QR check-in codes
APP_SECRET=change-this-to-a-long-random-string

# Base URL used to build personal invite links (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://www.da3wa.digital

# Upstash Redis (optional). If not set, the app falls back to a local
# JSON file at data/db.json — fine for local dev, but NOT persistent
# on Vercel/serverless between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wati WhatsApp Business API (required for real WhatsApp sending)
WATI_API_ENDPOINT=https://live-mt-server.wati.io/XXXXXXXX
WATI_ACCESS_TOKEN=
