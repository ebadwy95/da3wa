# Admin dashboard password (simple single-tenant auth for now)
ADMIN_PASSWORD=changeme

# Secret used to sign invite tokens and QR check-in codes.
# WARNING: changing this invalidates every invite link and every QR code that
# has already been sent to guests. Set it once and keep it.
APP_SECRET=change-this-to-a-long-random-string

# Base URL used to build personal invite links (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://www.da3wa.digital

# Upstash Redis (optional). If not set, the app falls back to a local
# JSON file at data/db.json — fine for local dev, but NOT persistent
# on Vercel/serverless between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp — Meta Cloud API, direct. This is the route messages take.
#
# Set up in a Meta developer app (developers.facebook.com → your app →
# WhatsApp → API Setup). When both the token and the phone number id are set,
# the app sends through Meta and ignores the Wati variables further down, even
# if those are still filled in.
# ---------------------------------------------------------------------------
# A System User token from Business Settings, NOT the 24-hour token on the API
# Setup page — that one expires and every send after it fails.
WHATSAPP_CLOUD_TOKEN=
# The sending number's id (a long number shown under the phone number on API
# Setup) — not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account id. Needed to read templates, so a send can be
# checked against the approved list before it goes to 200 guests.
WHATSAPP_WABA_ID=
# Optional. Pinned so a Meta version change can't alter payloads silently.
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Delivery webhook: WhatsApp → Configuration → Webhook in the Meta app.
#   Callback URL:  <site>/api/whatsapp/cloud-webhook
#   Verify token:  the value below (any long random string you choose)
#   Subscribe to:  messages
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Settings → Basic → App secret. Every webhook call is signed with it;
# without it the endpoint refuses everything rather than accept unsigned writes.
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Choosing a provider.
#
# Optional. One of: cloud, 360dialog, zoko, wati. When set, only that provider
# is used, and if its variables are empty nothing is sent (the dashboard shows
# "not configured"). When empty, the first configured one in that order wins.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=

# 360dialog — hosts the Cloud API and pays Meta from a prepaid balance, so no
# card is needed on Meta. Same templates and payloads as the direct route.
D360_API_KEY=
# Optional. Production by default. A sandbox key (send START on WhatsApp to
# +55 11 4673-3492) needs https://waba-sandbox.360dialog.io/v1 and only reaches
# your own number.
D360_API_URL=

# Zoko — sends a template as its name plus values in {{1}}, {{2}} order. Zoko's
# API can't list templates, so every template sent through it needs its order
# declared (built in for the da3wa_* templates, or in
# WHATSAPP_POSITIONAL_PARAM_ORDER). Delivery webhooks are not connected yet.
ZOKO_API_KEY=
ZOKO_API_URL=

# Variable order for numbered templates, as JSON, added to the built-in list:
#   {"my_template":["name","link"],"no_variables_template":[]}
WHATSAPP_POSITIONAL_PARAM_ORDER=

# ---------------------------------------------------------------------------
# Template names, one per automatic send.
#
# Templates must be created with NAMED variables ({{name}}, {{link}}, …), not
# numbered ones ({{1}}). The app fills variables by name, and refuses to guess
# which value belongs in {{1}} — a guest's link in the place of their name
# cannot be unsent.
#
# Names the app can fill: name, groom, bride, couple, link, date, time, venue,
# maplink.
#
# If a name is empty — or still a placeholder like "hello_world" — that send
# is refused with a reason instead of substituting something.
#
# The old WATI_*_TEMPLATE_NAME variables are still read when these are empty.
# ---------------------------------------------------------------------------
WHATSAPP_INVITE_TEMPLATE_NAME=
WHATSAPP_QR_TEMPLATE_NAME=
# Sent to confirmed guests two days before the wedding by the daily cron in
# vercel.json. Leave empty to keep reminders switched off.
WHATSAPP_REMINDER_TEMPLATE_NAME=

# ---------------------------------------------------------------------------
# Wati — the previous provider. Only used when the Cloud API variables above
# are empty. Its trial ended in September 2026; kept so the app can still run
# against it, not because it is in use.
# ---------------------------------------------------------------------------
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_INVITE_TEMPLATE_NAME=
WATI_QR_TEMPLATE_NAME=
WATI_REMINDER_TEMPLATE_NAME=
# Only needed on Wati accounts with more than one connected WhatsApp number.
WATI_CHANNEL_NUMBER=

# Shared secret for the reminder cron endpoint. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" on scheduled runs. REQUIRED — without
# it /api/cron/reminders refuses every request, since an open version of that
# endpoint would be a public "message every confirmed guest" button.
CRON_SECRET=

# Shared secret for Wati's delivery webhook. Point Wati at:
#   <site>/api/whatsapp/webhook?secret=<WATI_WEBHOOK_SECRET>
# Without this the endpoint refuses every request. Wati returning success on a
# send only means it queued the message — WhatsApp's real verdict (delivered,
# read, or refused, e.g. an unapproved display name) arrives here afterwards.
WATI_WEBHOOK_SECRET=

# Where enquiries from the public /start form are emailed.
ENQUIRY_EMAIL=hello@da3wa.digital

# SMTP for that notification. Optional: without it the enquiry is still stored
# and visible in the dashboard, and only the email is skipped — a lead is never
# lost to a mail misconfiguration.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
